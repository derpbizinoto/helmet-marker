{
    "manifestVersion": 5,
    "id": "com.derpbizinoto.helmetmarker",
    "name": "Helmet Marker",
    "version": "1.0.1",
    "main": "index.html",
    "host": {
        "app": "premierepro",
        "minVersion": "26.5.0"
    },
    "requiredPermissions": {
        "localFileSystem": "request",
        "clipboard": "readAndWrite"
    },
    "featureFlags": {
        "enableAlerts": true
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "helmetMarkerPanel",
            "label": { "default": "Helmet Marker" },
            "minimumSize": { "width": 360, "height": 300 },
            "maximumSize": { "width": 2000, "height": 2000 },
            "preferredDockedSize": { "width": 560, "height": 640 },
            "preferredFloatingSize": { "width": 640, "height": 700 },
            "icons": [
                { "width": 23, "height": 23, "path": "icons/panel-dark.png", "scale": [1], "theme": ["darkest", "dark", "medium"] },
                { "width": 23, "height": 23, "path": "icons/panel-light.png", "scale": [1], "theme": ["lightest", "light"] }
            ]
        }
    ],
    "icons": [
        { "width": 48, "height": 48, "path": "icons/plugin-icon.png", "scale": [1], "theme": ["all"], "species": ["pluginList"] }
    ]
}
